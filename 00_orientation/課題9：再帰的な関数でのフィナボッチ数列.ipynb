   "source": [
    "# prognum モジュールを呼ぶ\n",
    "import prognum\n",
    "\n",
    "# n番目までのフィボナッチ数列を表示\n",
    "n = int(input(\"フィボナッチ数列をいくつまで表示しますか？：\"))\n",
    "\n",
    "fib_list = [prognum.fibonacci(i) for i in range(1, n + 1)]\n",
    "print(f\"フィボナッチ数列（{n}項まで）：{fib_list}\")"
   ]
  }
 ],
